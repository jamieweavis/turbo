<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Backpack</string>
    <key>CFBundleDisplayName</key>
    <string>Backpack</string>
    <key>CFBundleIdentifier</key>
    <string>com.jamieweavis.backpack</string>
    <key>CFBundleExecutable</key>
    <string>Backpack</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <!-- Both versions are stamped from Cargo.toml by `just app`. -->
    <key>CFBundleShortVersionString</key>
    <string>0.0.0</string>
    <key>CFBundleVersion</key>
    <string>0.0.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>26.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- Shown in the camera prompt. Without it macOS ends the app when it asks. -->
    <key>NSCameraUsageDescription</key>
    <string>Backpack shows your camera in Camera Preview, only while the preview is open.</string>
    <!-- Shown in the Automation prompt the first time a media key goes to a music app. -->
    <key>NSAppleEventsUsageDescription</key>
    <string>Backpack sends your media keys (play/pause, next and previous) to the music app you choose.</string>
</dict>
</plist>
