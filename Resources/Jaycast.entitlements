<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Camera Preview. Under the hardened runtime, macOS refuses the camera without it. -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <!-- Media Keys sends play/pause, next and previous to music apps as Apple Events. Under
         the hardened runtime, macOS blocks them without it. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
